<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="10dp"
        android:paddingTop="4dp">

        <LinearLayout
            android:id="@+id/nav_panel"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Кабинет -->
            <LinearLayout
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/nav_home_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:text="🏠"/>
                <TextView
                    android:id="@+id/nav_home_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:text="Кабинет"/>
            </LinearLayout>

            <!-- Новости -->
            <LinearLayout
                android:id="@+id/nav_news"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/nav_news_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:text="📰"/>
                <TextView
                    android:id="@+id/nav_news_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:text="Новости"/>
            </LinearLayout>

            <!-- Кошелёк — центральная круглая кнопка -->
            <LinearLayout
                android:id="@+id/nav_wallet"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <FrameLayout
                    android:id="@+id/nav_wallet_btn"
                    android:layout_width="46dp"
                    android:layout_height="46dp">
                    <TextView
                        android:id="@+id/nav_wallet_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:text="💸"
                        android:layout_gravity="center"/>
                </FrameLayout>
                <TextView
                    android:id="@+id/nav_wallet_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"
                    android:text="Кошелёк"/>
            </LinearLayout>

            <!-- Меню -->
            <LinearLayout
                android:id="@+id/nav_more"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/nav_more_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:text="☰"/>
                    <TextView
                        android:id="@+id/nav_more_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="16dp"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:background="#ef4444"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:layout_gravity="top|end"
                        android:visibility="gone"/>
                </FrameLayout>
                <TextView
                    android:id="@+id/nav_more_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:text="Меню"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
