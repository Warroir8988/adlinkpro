<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_camp_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="← Назад"
            android:textColor="@color/primary"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="+ Создать рекламную кампанию"
            android:textColor="@color/primary"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Название кампании"
                android:textColor="@color/text_main"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/et_camp_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:hint="Например: Реклама моего интернет-магазина"
                android:inputType="text"
                android:maxLength="255"
                android:maxLines="1"
                android:padding="14dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_secondary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Тип рекламы"
                android:textColor="@color/text_main"
                android:textSize="14sp"/>

            <Spinner
                android:id="@+id/sp_camp_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_spinner"
                android:padding="10dp"
                android:popupBackground="@drawable/bg_spinner_dark"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Ссылка (куда ведёт)"
                android:textColor="@color/text_main"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/et_camp_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:hint="https://yoursite.com"
                android:inputType="textUri"
                android:maxLines="1"
                android:padding="14dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_secondary"/>

            <LinearLayout
                android:id="@+id/lay_text_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Текст ссылки (макс. 40 символов)"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"/>

                <EditText
                    android:id="@+id/et_camp_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input"
                    android:hint="Например: Лучший хостинг!"
                    android:inputType="text"
                    android:maxLength="40"
                    android:maxLines="1"
                    android:padding="14dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_secondary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="🎨 Цвет текста (необязательно)"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"/>

                <EditText
                    android:id="@+id/et_camp_color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input"
                    android:hint="#3498db"
                    android:inputType="textCapCharacters"
                    android:maxLength="7"
                    android:maxLines="1"
                    android:padding="14dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_secondary"/>

                <CheckBox
                    android:id="@+id/cb_camp_usecolor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Применить цвет"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"/>

                <CheckBox
                    android:id="@+id/cb_camp_blink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:padding="10dp"
                    android:text="✨ Сделать текст мигающим"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="👁 Предпросмотр ссылки:"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tv_link_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:text="Ваш текст ссылки"
                    android:textColor="@color/primary"
                    android:textSize="15sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="HTML-код соберётся автоматически при отправке формы."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lay_banner_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Файл баннера — PNG/JPEG/GIF/WebP, ровно 468×60, до 2 МБ"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"/>

                <Button
                    android:id="@+id/btn_pick_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="@color/primary"
                    android:text="Выбрать файл из галереи"
                    android:textColor="@color/white"/>

                <TextView
                    android:id="@+id/tv_banner_file"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Файл не выбран"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="HTML-код баннера (если файла нет)"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"/>

                <EditText
                    android:id="@+id/et_html_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input"
                    android:fontFamily="monospace"
                    android:gravity="top"
                    android:hint="&lt;a href=&quot;https://example.com&quot;&gt;&lt;img src=&quot;https://example.com/banner.jpg&quot; alt=&quot;Реклама&quot;&gt;&lt;/a&gt;"
                    android:inputType="textMultiLine"
                    android:minLines="4"
                    android:padding="14dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="12sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:text="💡 Пример кода баннера:\n&lt;a href=&quot;https://site.com&quot;&gt;&lt;img src=&quot;https://site.com/banner.jpg&quot; alt=&quot;Ad&quot;&gt;&lt;/a&gt;\n\nПример текстовой ссылки:\n&lt;a href=&quot;https://site.com&quot;&gt;Перейти на сайт&lt;/a&gt;"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Срок размещения (дней)"
                android:textColor="@color/text_main"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/et_camp_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:inputType="number"
                android:maxLines="1"
                android:padding="14dp"
                android:text="1"
                android:textColor="@color/text_main"/>

            <TextView
                android:id="@+id/tv_days_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Категории площадок — выберите хотя бы одну: кампания пойдёт только на них"
                android:textColor="@color/text_main"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Кампания показывается только на площадках отмеченных категорий — так вы платите за целевую аудиторию."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>

            <LinearLayout
                android:id="@+id/cats_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Промокод (необязательно)"
                android:textColor="@color/text_main"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/et_promo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:hint="SUMMER2026"
                android:inputType="textCapCharacters"
                android:maxLines="1"
                android:padding="14dp"
                android:textAllCaps="true"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_secondary"/>

            <Button
                android:id="@+id/btn_check_promo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/white"
                android:text="Проверить промокод"
                android:textColor="@color/primary"/>

            <TextView
                android:id="@+id/tv_promo_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_main"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tv_final_calc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:textColor="@color/text_main"
                android:textSize="13sp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tv_balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"/>

            <CheckBox
                android:id="@+id/cb_agree_terms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Я ознакомился и согласен с условиями размещения рекламы и подтверждаю, что моя реклама не содержит запрещённого контента (18+, мошенничество, пирамиды, запрещённые товары)."
                android:textColor="@color/text_main"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btn_camp_create"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/primary"
                android:text="🚀 Создать кампанию"
                android:textColor="@color/white"/>

            <TextView
                android:id="@+id/tv_camp_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/red"
                android:textSize="14sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Мои кампании:"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"/>

        <LinearLayout
            android:id="@+id/campaigns_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"/>
    </LinearLayout>
</ScrollView>
